  "scripts": {
    "develop": "node scripts/run-gatsby.js develop",
    "develop-host": "node scripts/run-gatsby.js develop --host 192.168.0.112",
    "build": "GATSBY_CPU_COUNT=1 node scripts/run-gatsby.js build",
    "serve": "node scripts/run-gatsby.js serve",
